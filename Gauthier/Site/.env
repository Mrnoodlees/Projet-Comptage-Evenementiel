# Port HTTP de l’API Node/Express.
PORT=3001

# Connexion PostgreSQL. En mode tunnel, DB_HOST/DB_PORT sont remplacés par localhost:SSH_TUNNEL_LOCAL_PORT.
DB_HOST=127.0.0.1
DB_PORT=25432
DB_NAME=projet_comptage
DB_USER=postgres
DB_PASSWORD=dot

# Timeouts BDD pour éviter qu’une requête bloquée fige l’application.
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000

# URLs utilisées par le frontend Vite pour appeler l’API et le Socket.IO.
VITE_API_BASE_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
VITE_ALLOW_LOCAL_LOGIN=true

# Origines autorisées à appeler l’API depuis un navigateur.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://178.32.107.35:5173,http://192.168.10.37:5173,http://192.168.10.37,http://192.168.10.36:5173,http://192.168.10.36

# Source Socket.IO externe que l’API relaie vers les dashboards connectés.
SOURCE_SOCKET_URL=http://192.168.10.36:3000

# Tunnel local vers la BDD distante : localhost:25432 -> 192.168.10.36:5432.
SSH_TUNNEL_ENABLED=true
SSH_TUNNEL_HOST=dotty@192.168.10.36
SSH_TUNNEL_USE_CONFIG=false
SSH_TUNNEL_LOCAL_PORT=25432
SSH_TUNNEL_REMOTE_HOST=127.0.0.1
SSH_TUNNEL_REMOTE_PORT=5432
SSH_TUNNEL_RECONNECT_MS=3000
SSH_TUNNEL_PASSWORD=dotmetheass
LOG_DB_CONFIG=true

# Tunnel inversé vers la VPS : permet à la VPS d’accéder à un service local.
REVERSE_SSH_ENABLED=true
REVERSE_SSH_HOST=gauthier@178.32.107.35
REVERSE_SSH_PASSWORD=gauthierfdp
REVERSE_SSH_REMOTE_PORT=15432
REVERSE_SSH_LOCAL_HOST=127.0.0.1
REVERSE_SSH_LOCAL_PORT=25432
REVERSE_SSH_REMOTE_BIND=127.0.0.1

# Clés SSH recommandées pour remplacer les mots de passe.
SSH_TUNNEL_IDENTITY=~/.ssh/id_ed25519_comptage_db
REVERSE_SSH_IDENTITY=~/.ssh/id_ed25519_comptage_vps

# Autorise une demande interactive de mot de passe SSH si aucune clé ne marche.
TUNNEL_ALLOW_PASSWORD_PROMPT=true

# Si false, le reset QR invalide les sessions mais ne révoque pas les tokens stockés.
QR_RESET_REVOKE=false
TUNNEL_ALLOW_PASSWORD_PROMPT=true
